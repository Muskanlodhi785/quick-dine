# ── QuickDine Server Environment ─────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# MongoDB connection string (local or Atlas).
# Local example: mongodb://127.0.0.1:27017/quickdine
MONGODB_URI=mongodb://127.0.0.1:27017/quickdine

# Secret used to sign JWTs - use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on. The client expects 5000 by default (keep in sync
# with VITE_API_URL in client/.env).
PORT=5000

# Set to "production" to disable request logging and stack traces.
NODE_ENV=development

# ── Cloudinary (restaurant image uploads) ─────────────────────
# Provide either CLOUDINARY_URL, or all three fields below.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Google Gemini API (AI restaurant recommendations) ─────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Model name - adjust to whatever Gemini model you have access to.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed CORS origins (production). Empty = allow all (dev).
# ALLOWED_ORIGINS=https://brohi-demo.vercel.app,http://localhost:5173
